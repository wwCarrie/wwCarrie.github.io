.toc-container
  position: sticky
  top: 80px
  max-height: calc(100vh - 120px)
  overflow-y: auto
  min-width: 200px
  width: 100%
  padding-left: 24px
  flex-shrink: 0

.toc-card
  @extend $card
  padding: 20px
  margin-bottom: 16px
  font-size: 14px
  line-height: 1.8

.toc-title
  color: var(--widget-title)
  font-size: 18px
  font-weight: bold
  margin-bottom: 12px
  transition: color trans-style
  display: flex
  &:before
    content: ''
    display: block
    height: 14px
    width: 4px
    border-radius: 2px
    background-color: var(--primary)
    margin-right: 10px
    margin-top: 4px
    margin-left: -4px

.toc
  list-style: none
  padding: 0
  margin: 0
  .toc-item
    margin: 4px 0
    .toc-link
      color: var(--neut-L50)
      text-decoration: none
      display: block
      padding: 2px 8px
      border-radius: 4px
      border-left: 2px solid transparent
      transition: color trans-style, background trans-style, border-color trans-style
      text-overflow: ellipsis
      overflow: hidden
      white-space: nowrap
      &:hover
        color: var(--link)
        background: var(--btn-text-hover)
      &.active
        color: var(--link)
        border-left-color: var(--primary)
        background: var(--btn-text-hover)
  .toc-child
    list-style: none
    padding-left: 16px
    margin: 0

// TOC toggle button for mobile
.toc-toggle
  display: none
  position: fixed
  right: 16px
  bottom: 80px
  z-index: 100
  width: 44px
  height: 44px
  border-radius: 50%
  background: var(--card-background)
  border: none
  cursor: pointer
  align-items: center
  justify-content: center
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15)
  transition: background trans-style, color trans-style
  color: var(--link)
  font-size: 20px
  &:hover
    background: var(--btn-bg)

// Post content layout with TOC
.post-content-wrapper
  display: flex
  gap: 0
  .post-article-area
    flex: 1
    min-width: 0      // prevent overflow
  .post-toc-area
    width: 260px
    flex-shrink: 0

// Responsive
@media mq-tablet
  .post-content-wrapper
    flex-direction: column
    .post-toc-area
      display: none       // Hidden by default on tablet/mobile
      position: fixed
      top: 60px
      right: 0
      z-index: 200
      width: 280px
      max-width: 80vw
      max-height: 70vh
      background: var(--card-background)
      border-radius: card-radius
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2)
      overflow-y: auto
      .toc-container
        position: static
        padding-left: 0
        max-height: none
      &.toc-visible
        display: block
  .toc-toggle
    display: flex

@media mq-mobile
  .post-content-wrapper
    flex-direction: column
    .post-toc-area
      display: none
      position: fixed
      top: 50px
      right: 4px
      z-index: 200
      width: 260px
      max-width: 80vw
      max-height: 65vh
      background: var(--card-background)
      border-radius: card-radius
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2)
      overflow-y: auto
      .toc-container
        position: static
        padding-left: 0
        max-height: none
      &.toc-visible
        display: block
  .toc-toggle
    display: flex
